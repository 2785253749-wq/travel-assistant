# Copy this file to .env and replace every placeholder with your own value.
# Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
AI_ENABLED=true
AI_USER_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=100
ANON_SESSION_SIGNING_SECRET=replace_with_at_least_32_random_characters_in_production
