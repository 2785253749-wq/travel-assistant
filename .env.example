# Copy this file to .env and replace every placeholder with your own value.
# Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
AMAP_JS_KEY=your_amap_javascript_key_here
AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
AI_ENABLED=true
# Daily limits count actual model invocations. Each planning request atomically
# reserves two slots (initial call plus possible repair), then releases unused slots.
AI_USER_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=100
REQUEST_ANONYMOUS_PER_MINUTE=30
REQUEST_AUTHENTICATED_PER_MINUTE=120
REQUEST_IP_PER_MINUTE=180
# Micro-CNY per one million tokens. Update from the current provider price.
AI_INPUT_COST_MICROS_PER_MILLION_TOKENS=0
AI_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=0
ANON_SESSION_SIGNING_SECRET=replace_with_at_least_32_random_characters_in_production
